<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudentBorrowEquipSystem.Desktop.ViewModels"
             xmlns:views="using:StudentBorrowEquipSystem.Desktop.Views"
             x:Class="StudentBorrowEquipSystem.Desktop.App"
             RequestedThemeVariant="Light">

    <!-- ViewModel -> View mapping. Views get their DataContext from the ContentControl; no service locator. -->
    <Application.DataTemplates>
        <DataTemplate DataType="vm:EquipmentViewModel"><views:EquipmentView /></DataTemplate>
        <DataTemplate DataType="vm:BorrowingViewModel"><views:BorrowView /></DataTemplate>
        <DataTemplate DataType="vm:ActiveBorrowingsViewModel"><views:ActiveBorrowingsView /></DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://StudentBorrowEquipSystem.Desktop/Styles/Styles.axaml" />
    </Application.Styles>
</Application>
