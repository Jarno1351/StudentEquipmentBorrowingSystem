<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StudentBorrowEquipSystem.Desktop.Views;assembly=StudentBorrowEquipSystem.Desktop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1000"
        d:DesignHeight="650"
        x:Class="StudentBorrowEquipSystem.Desktop.MainWindow"
        Title="Student Borrow Equipment System">

    <Grid
        RowDefinitions="Auto,*"
        ColumnDefinitions="200,*">

        <!-- HEADER -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Text="Student Borrowing Equipment System"
            FontSize="36"
            FontWeight="Bold"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            Foreground="#E63946"
            Margin="16,12"
            FontFamily="Poppins"/>


        <!-- SIDEBAR -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Padding="26">

            <StackPanel
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="16">

                <Button
                    Content="Equipment"
                    Width="160"
                    Height="45"/>

                <Button
                    Content="Active Borrowings"
                    Width="160"
                    Height="45"/>

            </StackPanel>

        </Border>


        <!-- MAIN CONTENT -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Padding="12">

            <TabControl>
                <TabItem Header="Borrow">
                    <views:BorrowView DataContext="{Binding BorrowingVM}" />
                </TabItem>
                <TabItem Header="Active Borrowings">
                    <ScrollViewer>
                        <StackPanel>
                            <ListBox Items="{Binding ActiveBorrowingsVM.ActiveBorrowings}"
                                     SelectedItem="{Binding ActiveBorrowingsVM.SelectedBorrow}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding StudentName}" Width="150" />
                                            <TextBlock Text="{Binding EquipmentName}" Width="150" />
                                            <TextBlock Text="{Binding BorrowDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="110" />
                                            <TextBlock Text="{Binding DueDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="110" />
                                            <Button Content="Return" Command="{Binding DataContext.ReturnSelected, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

        </Border>

    </Grid>

</Window>