<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StudentBorrowEquipSystem.Desktop.ViewModels"
        x:Class="StudentBorrowEquipSystem.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Student Equipment Borrowing System"
        Width="1000" Height="650" MinWidth="800" MinHeight="500"
        Background="{DynamicResource PageBackgroundBrush}">

    <Grid ColumnDefinitions="220,*">
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <StackPanel Margin="0,20" Spacing="4">
                <TextBlock Text="Equipment Borrowing" Foreground="White" FontSize="16"
                           FontWeight="Bold" Margin="16,0,16,20" TextWrapping="Wrap" />
                <Button Classes="nav" Content="Equipment"
                        Classes.active="{Binding IsEquipmentActive}"
                        Command="{Binding ShowEquipmentCommand}" />
                <Button Classes="nav" Content="Borrow"
                        Classes.active="{Binding IsBorrowActive}"
                        Command="{Binding ShowBorrowCommand}" />
                <Button Classes="nav" Content="Active Borrowings"
                        Classes.active="{Binding IsActiveBorrowingsActive}"
                        Command="{Binding ShowActiveBorrowingsCommand}" />
            </StackPanel>
        </Border>

        <!-- Current page: resolved through the DataTemplates in App.axaml -->
        <ScrollViewer Grid.Column="1">
            <ContentControl Margin="28" Content="{Binding Navigation.CurrentViewModel}" />
        </ScrollViewer>
    </Grid>
</Window>
