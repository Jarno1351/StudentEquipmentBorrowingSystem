<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="StudentBorrowEquipSystem.Desktop.MainWindow"
        Title="Student Borrow Equipment System">

    <Grid 
        RowDefinitions="Auto, *" 
        ColumnDefinitions="200, *">
    
    <!-- Header (Row 0, Column 0) -->
    <TextBlock  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
               Text="Student Borrowing Equipment System" 
               FontSize="36"
               FontWeight="Bold"
               TextAlignment="Center"
               HorizontalAlignment="Center"
               Foreground="#E63946"
               Margin="16,12,16,12"
               FontFamily="Poppins"/>
    

    <!-- Sidebar Content  -->
   <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical" Spacing="16">
    <Button Content="Equipment" />
    <Button Content="Borrowing" />
    </StackPanel>
    <!-- Main Content-->
    <TextBox Grid.Row="1" Grid.Column="1" Text="Main Content Area" />

</Grid>
</Window>
