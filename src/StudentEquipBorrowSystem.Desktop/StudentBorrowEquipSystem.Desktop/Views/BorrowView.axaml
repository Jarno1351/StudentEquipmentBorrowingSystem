<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudentBorrowEquipSystem.Desktop.ViewModels"
             xmlns:dto="using:Applications.Dto"
             x:Class="StudentBorrowEquipSystem.Desktop.Views.BorrowView"
             x:DataType="vm:BorrowingViewModel">

    <StackPanel Spacing="16" HorizontalAlignment="Left" MaxWidth="560">
        <TextBlock Classes="pageHeader" Text="Borrow Equipment" />

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="label" Text="Student" />
                <ComboBox ItemsSource="{Binding Students}"
                          SelectedItem="{Binding SelectedStudent}"
                          PlaceholderText="Select student">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:StudentDto">
                            <TextBlock Text="{Binding FullName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Classes="label" Text="Equipment" Margin="0,6,0,0" />
                <ComboBox ItemsSource="{Binding Equipment}"
                          SelectedItem="{Binding SelectedEquipment}"
                          PlaceholderText="Select equipment">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:EquipmentDto">
                            <TextBlock Text="{Binding EquipmentName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Classes="label" Text="Due Date" Margin="0,6,0,0" />
                <CalendarDatePicker SelectedDate="{Binding DueDate}" Watermark="Select date" />

                <Button Classes="primary" Content="Borrow Equipment"
                        Command="{Binding BorrowCommand}" Margin="0,12,0,0"
                        HorizontalAlignment="Left" />

                <!-- input validation hint (why the button is disabled) -->
                <TextBlock Classes="hint" Text="{Binding ValidationMessage}"
                           IsVisible="{Binding HasValidationMessage}" />

                <!-- operation result (success or business/application error) -->
                <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}"
                           Classes.error="{Binding IsError}"
                           Classes.success="{Binding !IsError}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
