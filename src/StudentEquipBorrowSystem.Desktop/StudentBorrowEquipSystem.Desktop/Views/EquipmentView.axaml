<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudentBorrowEquipSystem.Desktop.ViewModels"
             x:Class="StudentBorrowEquipSystem.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

    <StackPanel Spacing="16">
        <TextBlock Classes="pageHeader" Text="Equipment" />

        <ItemsControl ItemsSource="{Binding Equipment}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EquipmentItemViewModel">
                    <Border Classes="card" Width="200" Margin="0,0,14,14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding EquipmentName}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Classes="hint" Text="{Binding EquipmentType}" />
                            <TextBlock Text="Available" Classes="success" IsVisible="{Binding IsAvailable}" Margin="0,8,0,0" />
                            <TextBlock Text="Borrowed" Classes="error" IsVisible="{Binding !IsAvailable}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
