<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StudentBorrowEquipSystem.Desktop.ViewModels"
             xmlns:dto="using:Applications.Dto"
             x:Class="StudentBorrowEquipSystem.Desktop.Views.ActiveBorrowingsView"
             x:DataType="vm:ActiveBorrowingsViewModel">

    <StackPanel Spacing="16">
        <TextBlock Classes="pageHeader" Text="Active Borrowings" />

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="label" Text="Select a borrowing to return" />

                <ListBox ItemsSource="{Binding ActiveBorrowings}"
                         SelectedItem="{Binding SelectedBorrow}"
                         MinHeight="120" MaxHeight="280">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:BorrowDto">
                            <Grid ColumnDefinitions="2*,2*,*,*" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="{Binding EquipmentName}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding StudentName}" />
                                <TextBlock Grid.Column="2" Text="{Binding BorrowDate, StringFormat='Borrowed {0:yyyy-MM-dd}'}" Classes="hint" />
                                <TextBlock Grid.Column="3" Text="{Binding DueDate, StringFormat='Due {0:yyyy-MM-dd}'}" Classes="hint" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Classes="label" Text="Return Date" Margin="0,6,0,0" />
                <CalendarDatePicker SelectedDate="{Binding ReturnDate}" Watermark="Select date"
                                    HorizontalAlignment="Left" MinWidth="220" />

                <Button Classes="primary" Content="Return Equipment"
                        Command="{Binding ReturnSelectedCommand}" Margin="0,12,0,0"
                        HorizontalAlignment="Left" />

                <TextBlock Classes="hint" Text="{Binding ValidationMessage}"
                           IsVisible="{Binding HasValidationMessage}" />

                <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}"
                           Classes.error="{Binding IsError}"
                           Classes.success="{Binding !IsError}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
