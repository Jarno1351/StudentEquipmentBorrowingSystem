<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="StudentBorrowEquipSystem.Desktop.Views.ActiveBorrowingsView"
             xmlns:app="clr-namespace:Applications.Dto;assembly=StudentBorrowEquipSystem.Application"
             x:DataType="vm:ActiveBorrowingsViewModel"
             xmlns:vm="clr-namespace:StudentBorrowEquipSystem.Desktop.ViewModels;assembly=StudentBorrowEquipSystem.Desktop">

  <StackPanel Spacing="12" Margin="12">
    <TextBlock Text="Active Borrowings" FontSize="22" FontWeight="Bold" />

    <ListBox Items="{Binding ActiveBorrowings}"
             SelectedItem="{Binding SelectedBorrow}"
             HorizontalContentAlignment="Stretch">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="8" BorderThickness="1" Margin="0,4" CornerRadius="4">
            <Grid ColumnDefinitions="2*,2*,Auto,Auto,Auto" VerticalAlignment="Center">
              <TextBlock Grid.Column="0" Text="{Binding StudentName}" />
              <TextBlock Grid.Column="1" Text="{Binding EquipmentName}" />
              <TextBlock Grid.Column="2" Text="{Binding BorrowDate, StringFormat='{}{0:yyyy-MM-dd}'}" />
              <TextBlock Grid.Column="3" Text="{Binding DueDate, StringFormat='{}{0:yyyy-MM-dd}'}" />
              <Button Grid.Column="4" Content="Return" Command="{Binding DataContext.ReturnSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Return Date:" VerticalAlignment="Center" />
      <DatePicker SelectedDate="{Binding ReturnDate}" />
    </StackPanel>

    <TextBlock Text="{Binding StatusMessage}" Foreground="Red" />
  </StackPanel>

</UserControl>
